                </mxCell>
                <mxCell id="math" value="&lt;font style=&quot;font-size:24px;color:#283593&quot;&gt;2&lt;/font&gt;&lt;font style=&quot;font-size:12px;color:#666&quot;&gt; (guest mirror)&lt;/font&gt;&amp;nbsp;&amp;nbsp;&lt;font style=&quot;font-size:24px;color:#333&quot;&gt;×&lt;/font&gt;&amp;nbsp;&amp;nbsp;&lt;font style=&quot;font-size:24px;color:#c62828&quot;&gt;2&lt;/font&gt;&lt;font style=&quot;font-size:12px;color:#666&quot;&gt; (host mirror)&lt;/font&gt;&amp;nbsp;&amp;nbsp;&lt;font style=&quot;font-size:24px;color:#333&quot;&gt;=&lt;/font&gt;&amp;nbsp;&amp;nbsp;&lt;font style=&quot;font-size:28px;color:#2e7d32&quot;&gt;&lt;b&gt;4 copies&lt;/b&gt;&lt;/font&gt;" style="text;html=1;align=center;" parent="1" vertex="1">
                    <mxGeometry x="430" y="135" width="610" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="table_head" value="&lt;table style=&quot;font-size:11px;border-collapse:collapse;width:100%&quot;&gt;&lt;tr style=&quot;background:#e8eaf6;font-weight:bold&quot;&gt;&lt;td style=&quot;padding:4px;border:1px solid #999&quot;&gt;Copy&lt;/td&gt;&lt;td style=&quot;padding:4px;border:1px solid #999&quot;&gt;SOFS VM&lt;/td&gt;&lt;td style=&quot;padding:4px;border:1px solid #999&quot;&gt;Azure Local Node&lt;/td&gt;&lt;td style=&quot;padding:4px;border:1px solid #999&quot;&gt;Physical Drive&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:4px;border:1px solid #ccc&quot;&gt;1&lt;/td&gt;&lt;td style=&quot;padding:4px;border:1px solid #ccc&quot;&gt;vm-klr-sofs-01&lt;/td&gt;&lt;td style=&quot;padding:4px;border:1px solid #ccc&quot;&gt;azl-klr-bal-n01&lt;/td&gt;&lt;td style=&quot;padding:4px;border:1px solid #ccc&quot;&gt;NVMe drive A&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:4px;border:1px solid #ccc&quot;&gt;2&lt;/td&gt;&lt;td style=&quot;padding:4px;border:1px solid #ccc&quot;&gt;vm-klr-sofs-01&lt;/td&gt;&lt;td style=&quot;padding:4px;border:1px solid #ccc&quot;&gt;azl-klr-bal-n02&lt;/td&gt;&lt;td style=&quot;padding:4px;border:1px solid #ccc&quot;&gt;NVMe drive B&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:4px;border:1px solid #ccc&quot;&gt;3&lt;/td&gt;&lt;td style=&quot;padding:4px;border:1px solid #ccc&quot;&gt;vm-klr-sofs-02&lt;/td&gt;&lt;td style=&quot;padding:4px;border:1px solid #ccc&quot;&gt;azl-klr-bal-n02&lt;/td&gt;&lt;td style=&quot;padding:4px;border:1px solid #ccc&quot;&gt;NVMe drive C&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:4px;border:1px solid #ccc&quot;&gt;4&lt;/td&gt;&lt;td style=&quot;padding:4px;border:1px solid #ccc&quot;&gt;vm-klr-sofs-02&lt;/td&gt;&lt;td style=&quot;padding:4px;border:1px solid #ccc&quot;&gt;azl-klr-bal-n03&lt;/td&gt;&lt;td style=&quot;padding:4px;border:1px solid #ccc&quot;&gt;NVMe drive D&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;overflow=fill;" parent="1" vertex="1">
                    <mxGeometry x="440" y="185" width="590" height="130" as="geometry"/>
                </mxCell>
                <mxCell id="why_box" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f5e9;strokeColor=#2e7d32;strokeWidth=2;shadow=1;" parent="1" vertex="1">
                    <mxGeometry x="420" y="355" width="630" height="210" as="geometry"/>
                </mxCell>
                <mxCell id="why_title" value="&lt;b&gt;Why Nested Resiliency Is Not Needed&lt;/b&gt;" style="text;html=1;fontSize=13;fontColor=#2e7d32;align=center;" parent="1" vertex="1">
                    <mxGeometry x="520" y="360" width="420" height="25" as="geometry"/>
                </mxCell>
                <mxCell id="why_text" value="&lt;font style=&quot;font-size:10px&quot;&gt;&lt;b&gt;Nested resiliency&lt;/b&gt; (nested two-way mirror) is designed exclusively for &lt;b&gt;2-node S2D clusters&lt;/b&gt; where a single node failure leaves only one data copy with no remaining fault tolerance. It creates 4 copies within one S2D layer (2 local per node + 2 cross-node).&lt;br&gt;&lt;br&gt;&lt;b&gt;Keller has 3-node clusters at both layers&lt;/b&gt;, making nested resiliency unnecessary:&lt;br&gt;&lt;br&gt;• &lt;b&gt;Host&lt;/b&gt; (Azure Local, 3 nodes): Standard 2-way mirror tolerates any single node failure with a full copy remaining on a third node&lt;br&gt;• &lt;b&gt;Guest&lt;/b&gt; (SOFS, 3 VMs across hosts): Same single-failure tolerance with data spread across 3 VMs&lt;br&gt;&lt;br&gt;The stacked design delivers &lt;b&gt;4 independent copies&lt;/b&gt; — matching nested resiliency&#39;s protection without its capacity overhead. Adding nested resiliency at the host layer would yield 2 × 4 = &lt;b&gt;8 copies&lt;/b&gt;, requiring ~80 TB raw — nearly double the 42 TB allocatable pool — for no practical benefit.&lt;/font&gt;" style="text;whiteSpace=wrap;html=1;align=left;overflow=hidden;" parent="1" vertex="1">
                    <mxGeometry x="435" y="390" width="595" height="300" as="geometry"/>
                </mxCell>
                <mxCell id="footer" value="Azure Local 2-way × SOFS 2-way = 4 physical copies · Raw multiplier ~4.5 : 1 · 41,640 GB pool consumed of 42,639 GB allocatable" style="text;html=1;fontSize=9;fontColor=#666666;fontStyle=2;align=center;" parent="1" vertex="1">
                    <mxGeometry x="150" y="730" width="800" height="20" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
</mxfile>