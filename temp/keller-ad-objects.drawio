<mxfile host="draw.io" type="device">
  <diagram name="AD Objects" id="ad1">
    <mxGraphModel dx="1100" dy="750" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1050" pageHeight="680">
      <root>
        <mxCell id="0"/>
