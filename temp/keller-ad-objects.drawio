        </mxCell>
        <mxCell id="perm_table" value="&lt;table style=&quot;font-size:10px;border-collapse:collapse;width:100%&quot;&gt;&lt;tr style=&quot;background:#e8eaf6;font-weight:bold&quot;&gt;&lt;td style=&quot;padding:5px;border:1px solid #999;width:25%&quot;&gt;Object&lt;/td&gt;&lt;td style=&quot;padding:5px;border:1px solid #999;width:30%&quot;&gt;Permission Needed&lt;/td&gt;&lt;td style=&quot;padding:5px;border:1px solid #999;width:45%&quot;&gt;Why&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:4px;border:1px solid #ccc&quot;&gt;CNO (klr-sofs)&lt;/td&gt;&lt;td style=&quot;padding:4px;border:1px solid #ccc&quot;&gt;Create Computer Objects on OU=SOFS&lt;/td&gt;&lt;td style=&quot;padding:4px;border:1px solid #ccc&quot;&gt;CNO must create the VCO (klr-fslogix) in the same OU&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:4px;border:1px solid #ccc&quot;&gt;Installer account&lt;/td&gt;&lt;td style=&quot;padding:4px;border:1px solid #ccc&quot;&gt;Domain Admin or delegated OU admin&lt;/td&gt;&lt;td style=&quot;padding:4px;border:1px solid #ccc&quot;&gt;Join VMs to domain, create cluster (pre-stages CNO)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:4px;border:1px solid #ccc&quot;&gt;GPO&lt;/td&gt;&lt;td style=&quot;padding:4px;border:1px solid #ccc&quot;&gt;Link to AVD session host OU&lt;/td&gt;&lt;td style=&quot;padding:4px;border:1px solid #ccc&quot;&gt;Set FSLogix VHDLocations to \\klr-fslogix\Profiles etc.&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;overflow=fill;" vertex="1" parent="1">
