# =============================================================================
# SOFS on Azure Local — Ansible Inventory
# =============================================================================
# AUTO-GENERATED by Terraform — do not edit manually.
# Regenerate with: terraform apply
#
# Generated: ${timestamp}
# Terraform workspace: ${workspace}
# =============================================================================

all:
  vars:
    # --- Azure subscription & resource group ---
    sofs_subscription_id: "${subscription_id}"
    sofs_resource_group: "${resource_group}"
    sofs_location: "${location}"

    # --- Azure Local infrastructure IDs ---
    sofs_custom_location_id: "${custom_location_id}"
    sofs_logical_network_id: "${logical_network_id}"
    sofs_gallery_image_id: "${gallery_image_id}"
    sofs_storage_path_ids:
%{ for suffix, path_id in storage_path_ids ~}
      "${suffix}": "${path_id}"
%{ endfor ~}

    # --- VM configuration ---
    sofs_vm_prefix: "${vm_prefix}"
    sofs_vm_count: ${vm_count}
    sofs_vm_processors: ${vm_processors}
    sofs_vm_memory_mb: ${vm_memory_mb}
    sofs_admin_username: "${admin_username}"
    # sofs_admin_password: use ansible-vault or --extra-vars at runtime
%{ if length(vm_ips) > 0 ~}
    sofs_vm_ips:
%{ for suffix, ip in vm_ips ~}
      "${suffix}": "${ip}"
%{ endfor ~}
%{ endif ~}

    # --- Data disks ---
    sofs_data_disk_count: ${data_disk_count}
    sofs_data_disk_size_gb: ${data_disk_size_gb}

    # --- Cloud witness (populated from Terraform output) ---
    sofs_cloud_witness_name: "${cloud_witness_name}"
    sofs_witness_key: "${witness_key}"

    # --- Guest cluster configuration ---
    sofs_cluster_name: "${cluster_name}"
    sofs_cluster_ip: "${cluster_ip}"
    sofs_access_point: "${access_point}"
    sofs_share_name: "${share_name}"
    sofs_s2d_volume_name: "${s2d_volume_name}"
    sofs_s2d_volume_size: "${s2d_volume_size}"
    sofs_s2d_data_copies: ${s2d_data_copies}
    sofs_s2d_pool_name: "${s2d_pool_name}"
    sofs_role_name: "${sofs_role_name}"
    sofs_smb_encryption: ${smb_encryption}
    sofs_guest_volume_layout: "${guest_volume_layout}"
    sofs_guest_resiliency: "${guest_resiliency}"
%{ if length(sofs_shares) > 0 ~}
    sofs_shares:
%{ for share in sofs_shares ~}
      - name: "${share.name}"
        volume: "${share.volume}"
%{ endfor ~}
%{ endif ~}
%{ if length(s2d_volumes) > 0 ~}
    sofs_s2d_volumes:
%{ for vol in s2d_volumes ~}
      - name: "${vol.name}"
        size_gb: ${vol.size_gb}
        data_copies: ${vol.data_copies}
%{ endfor ~}
%{ endif ~}
    sofs_domain_fqdn: "${domain_fqdn}"
    sofs_domain_netbios: "${domain_netbios}"
    sofs_domain_ou_nodes: "${domain_ou_nodes}"
    sofs_domain_ou_cluster: "${domain_ou_cluster}"
    sofs_anti_affinity_rule: "${anti_affinity_rule}"
    sofs_azl_cluster_name: "${azl_cluster_name}"

    # --- Permissions ---
    sofs_permissions_admin_group: "${permissions_admin_group}"
    sofs_permissions_users_group: "${permissions_users_group}"
    sofs_permissions_avd_users_group: "${permissions_avd_users_group}"

    # --- FSLogix ---
    sofs_fslogix_enabled: ${fslogix_enabled}
    sofs_fslogix_profile_size_mb: ${fslogix_profile_size_mb}
    sofs_fslogix_volume_type: "${fslogix_volume_type}"
    sofs_cloud_cache_enabled: ${cloud_cache_enabled}
%{ if length(cloud_cache_providers) > 0 ~}
    sofs_cloud_cache_providers:
%{ for p in cloud_cache_providers ~}
      - type: "${p.type}"
        connectionString: "${p.connectionString}"
%{ endfor ~}
%{ else ~}
    sofs_cloud_cache_providers: []
%{ endif ~}

    # --- DNS servers ---
%{ if length(dns_servers) > 0 ~}
    sofs_dns_servers:
%{ for dns in dns_servers ~}
      - "${dns}"
%{ endfor ~}
%{ endif ~}

    # --- WinRM connection for Windows targets ---
    ansible_connection: winrm
    ansible_winrm_transport: ${winrm_transport}
    ansible_winrm_server_cert_validation: ignore
    ansible_port: 5986

  children:
    sofs_nodes:
      hosts:
%{ for vm in vm_hosts ~}
        ${vm.name}:
          ansible_host: ${vm.ip}
%{ endfor ~}
