{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/AzureLocal/azurelocal-sofs-fslogix/config/schema/variables.schema.json",
  "title": "SOFS FSLogix Variables",
  "description": "Schema for config/variables.example.yml — validates required sections and key structure.",
  "type": "object",
  "required": ["deployment", "azure", "keyvault", "azure_local", "vm", "data_disks", "domain", "dns_servers", "sofs", "s2d", "cloud_witness", "guest_config_engine", "tags"],
  "properties": {
    "deployment": {
      "type": "object",
      "required": ["host_volume_layout", "host_resiliency", "guest_volume_layout", "guest_resiliency"],
      "properties": {
        "host_volume_layout": { "type": "string", "enum": ["three_volumes", "single_volume"] },
        "host_resiliency": { "type": "string", "enum": ["two_way", "three_way"] },
        "guest_volume_layout": { "type": "string", "enum": ["option_a", "option_b"] },
        "guest_resiliency": { "type": "string", "enum": ["two_way", "three_way"] }
      }
    },
    "azure": {
      "type": "object",
      "required": ["tenant_id", "subscription_id", "resource_group", "location"],
      "properties": {
        "tenant_id": { "type": "string" },
        "subscription_id": { "type": "string" },
        "resource_group": { "type": "string" },
        "location": { "type": "string" }
      }
    },
    "keyvault": {
      "type": "object",
      "required": ["name", "tenant_id", "subscription_id", "resource_group"],
      "properties": {
        "name": { "type": "string" },
        "tenant_id": { "type": "string" },
        "subscription_id": { "type": "string" },
        "resource_group": { "type": "string" }
      }
    },
    "azure_local": {
      "type": "object",
      "required": ["cluster_name", "custom_location_id", "logical_network_id", "gallery_image_name"],
      "properties": {
        "cluster_name": { "type": "string" },
        "custom_location_id": { "type": "string" },
        "logical_network_id": { "type": "string" },
        "gallery_image_name": { "type": "string" },
        "storage_path_id": { "type": "string" },
        "storage_path_ids": { "type": "object", "additionalProperties": { "type": "string" } }
      }
    },
    "vm": {
      "type": "object",
      "required": ["prefix", "count", "processors", "memory_mb", "admin_username", "admin_password", "ips"],
      "properties": {
        "prefix": { "type": "string" },
        "count": { "type": "integer", "minimum": 2, "maximum": 16 },
        "processors": { "type": "integer", "minimum": 1 },
        "memory_mb": { "type": "integer", "minimum": 1024 },
        "os_disk_size_gb": { "type": "integer", "minimum": 1 },
        "admin_username": { "type": "string" },
        "admin_password": { "type": "string" },
        "ips": { "type": "object", "additionalProperties": { "type": "string" } }
      }
    },
    "data_disks": {
      "type": "object",
      "required": ["count", "size_gb"],
      "properties": {
        "count": { "type": "integer", "minimum": 1 },
        "size_gb": { "type": "integer", "minimum": 1 },
        "dynamic": { "type": "boolean" }
      }
    },
    "domain": {
      "type": "object",
      "required": ["fqdn", "netbios", "join_username", "join_password"],
      "properties": {
        "fqdn": { "type": "string" },
        "netbios": { "type": "string" },
        "join_username": { "type": "string" },
        "join_password": { "type": "string" },
        "cluster_ou_path": { "type": "string" },
        "nodes_ou_path": { "type": "string" }
      }
    },
    "dns_servers": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1
    },
    "sofs": {
      "type": "object",
      "required": ["role_name", "cluster_name", "cluster_ip", "access_point_ip"],
      "properties": {
        "role_name": { "type": "string" },
        "cluster_name": { "type": "string" },
        "cluster_ip": { "type": "string" },
        "access_point_ip": { "type": "string" },
        "role_enabled": { "type": "boolean" },
        "anti_affinity_rule_name": { "type": "string" },
        "smb_encryption": { "type": "boolean" },
        "caching_mode": { "type": "string", "enum": ["None", "Manual", "Documents", "Programs"] },
        "continuous_availability": { "type": "boolean" },
        "folder_enumeration_mode": { "type": "string", "enum": ["AccessBased", "Unrestricted"] },
        "share_name": { "type": "string" },
        "shares": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "volume"],
            "properties": {
              "name": { "type": "string" },
              "volume": { "type": "string" }
            }
          }
        }
      }
    },
    "s2d": {
      "type": "object",
      "required": ["pool_name"],
      "properties": {
        "pool_name": { "type": "string" },
        "volume_name": { "type": "string" },
        "volume_size_gb": { "type": "integer" },
        "data_copies": { "type": "integer", "enum": [2, 3] },
        "volumes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "size_gb", "data_copies"],
            "properties": {
              "name": { "type": "string" },
              "size_gb": { "type": "integer" },
              "data_copies": { "type": "integer", "enum": [2, 3] }
            }
          }
        }
      }
    },
    "cloud_witness": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": { "type": "string" },
        "endpoint": { "type": "string" },
        "key_uri": { "type": "string" },
        "key_secret": { "type": "string" }
      }
    },
    "guest_config_engine": {
      "type": "string",
      "enum": ["ansible_create", "ansible_existing", "manual"]
    },
    "ansible_controller": {
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "size": { "type": "string" },
        "admin_username": { "type": "string" },
        "ssh_public_key_path": { "type": "string" },
        "private_ip": { "type": "string" },
        "hub_subnet_id": { "type": "string" },
        "hub_rg": { "type": "string" },
        "existing_controller_ip": { "type": "string" },
        "existing_controller_user": { "type": "string" }
      }
    },
    "host_volumes": {
      "type": "object",
      "required": ["storage_pool_name"],
      "properties": {
        "storage_pool_name": { "type": "string" },
        "name": { "type": "string" },
        "size_tb": { "type": "number" },
        "volumes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "size_tb"],
            "properties": {
              "name": { "type": "string" },
              "size_tb": { "type": "number" }
            }
          }
        }
      }
    },
    "permissions": {
      "type": "object",
      "required": ["admin_group", "users_group"],
      "properties": {
        "admin_group": { "type": "string" },
        "users_group": { "type": "string" },
        "avd_users_group": { "type": "string" }
      }
    },
    "fslogix": {
      "type": "object",
      "required": ["enabled"],
      "properties": {
        "enabled": { "type": "boolean" },
        "profile_size_mb": { "type": "integer" },
        "volume_type": { "type": "string", "enum": ["VHDX", "VHD"] },
        "flip_flop_name": { "type": "boolean" },
        "delete_local_profile": { "type": "boolean" },
        "cloud_cache": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "azure_provider": { "type": "string", "description": "Deprecated — use providers array" },
            "providers": {
              "type": "array",
              "description": "Ordered list of additional Cloud Cache providers (e.g. Azure Blob DR). SMB providers are auto-generated from SOFS shares.",
              "items": {
                "type": "object",
                "required": ["type", "connectionString"],
                "properties": {
                  "type": { "type": "string", "enum": ["smb", "azure", "smb2"] },
                  "connectionString": { "type": "string" }
                }
              }
            }
          }
        }
      }
    },
    "tags": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "winrm": {
      "type": "object",
      "properties": {
        "transport": { "type": "string", "enum": ["kerberos", "ntlm", "basic"] },
        "port": { "type": "integer", "enum": [5985, 5986] },
        "use_ssl": { "type": "boolean" },
        "cert_validation": { "type": "string", "enum": ["ignore", "validate"] }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "deployment": {
            "properties": { "guest_volume_layout": { "const": "option_a" } },
            "required": ["guest_volume_layout"]
          }
        },
        "required": ["deployment"]
      },
      "then": {
        "properties": {
          "s2d": { "required": ["pool_name", "volume_name", "volume_size_gb", "data_copies"] },
          "sofs": { "required": ["role_name", "cluster_name", "cluster_ip", "access_point_ip", "share_name"] }
        }
      }
    },
    {
      "if": {
        "properties": {
          "deployment": {
            "properties": { "guest_volume_layout": { "const": "option_b" } },
            "required": ["guest_volume_layout"]
          }
        },
        "required": ["deployment"]
      },
      "then": {
        "properties": {
          "s2d": { "required": ["pool_name", "volumes"] },
          "sofs": { "required": ["role_name", "cluster_name", "cluster_ip", "access_point_ip", "shares"] }
        }
      }
    },
    {
      "if": {
        "properties": {
          "deployment": {
            "properties": { "host_volume_layout": { "const": "single_volume" } },
            "required": ["host_volume_layout"]
          }
        },
        "required": ["deployment"]
      },
      "then": {
        "properties": {
          "host_volumes": { "required": ["storage_pool_name", "name", "size_tb"] }
        }
      }
    },
    {
      "if": {
        "properties": {
          "deployment": {
            "properties": { "host_volume_layout": { "const": "three_volumes" } },
            "required": ["host_volume_layout"]
          }
        },
        "required": ["deployment"]
      },
      "then": {
        "properties": {
          "host_volumes": { "required": ["storage_pool_name", "volumes"] }
        }
      }
    },
    {
      "if": {
        "properties": {
          "deployment": {
            "properties": { "host_resiliency": { "const": "three_way" } },
            "required": ["host_resiliency"]
          }
        },
        "required": ["deployment"]
      },
      "then": {
        "properties": {
          "vm": { "properties": { "count": { "minimum": 3 } } }
        }
      }
    },
    {
      "if": {
        "properties": {
          "deployment": {
            "properties": { "guest_resiliency": { "const": "three_way" } },
            "required": ["guest_resiliency"]
          }
        },
        "required": ["deployment"]
      },
      "then": {
        "properties": {
          "vm": { "properties": { "count": { "minimum": 3 } } }
        }
      }
    }
  ],
  "additionalProperties": false
}
