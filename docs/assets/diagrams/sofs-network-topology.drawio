        <mxCell id="node3" value="&lt;b&gt;iic-01-n03&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;3 × 7.68 TB NVMe&lt;br&gt;Hosts iic-sofs-03&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffcdd2;strokeColor=#c62828;fontSize=10;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="590" y="595" width="240" height="55" as="geometry"/>
        </mxCell>

        <!-- Traffic flow arrows -->
        <!-- SMB between SOFS VMs (S2D replication) -->
        <mxCell id="s2d_12" value="" style="endArrow=classic;startArrow=classic;html=1;strokeColor=#82b366;strokeWidth=2;" edge="1" parent="1" source="sofs1_net" target="sofs2_net">
