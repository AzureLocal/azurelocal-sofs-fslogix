        <mxCell id="node2" value="&lt;b&gt;iic-01-n02&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;3 × 7.68 TB NVMe&lt;br&gt;Hosts iic-sofs-02&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffcdd2;strokeColor=#c62828;fontSize=10;shadow=1;" vertex="1" parent="1">
