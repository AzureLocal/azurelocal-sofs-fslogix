        <mxCell id="cw" value="☁ &lt;b&gt;Cloud Witness&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;stsofswitnessiic01&lt;br&gt;Azure Blob Storage&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#deecf9;strokeColor=#6c8ebf;fontSize=10;shadow=1;" vertex="1" parent="1">
