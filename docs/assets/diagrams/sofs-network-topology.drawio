        </mxCell>
        <mxCell id="s2d_23" value="" style="endArrow=classic;startArrow=classic;html=1;strokeColor=#82b366;strokeWidth=2;" edge="1" parent="1" source="sofs2_net" target="sofs3_net">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="s2d_13" value="" style="endArrow=classic;startArrow=classic;html=1;strokeColor=#82b366;strokeWidth=2;curved=1;" edge="1" parent="1" source="sofs1_net" target="sofs3_net">
