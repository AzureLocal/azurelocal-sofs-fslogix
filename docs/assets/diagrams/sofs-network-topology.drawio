          <mxGeometry x="910" y="530" width="240" height="25" as="geometry"/>
        </mxCell>

        <!-- Footer -->
        <mxCell id="footer" value="✓ Single NIC per SOFS VM · all traffic shares one compute network · Cloud Witness requires outbound HTTPS to Azure" style="text;html=1;fontSize=9;fontColor=#666666;fontStyle=2;align=center;" vertex="1" parent="1">
