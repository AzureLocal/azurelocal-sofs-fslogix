<mxfile host="draw.io" type="device">
  <diagram name="Patching Sequence" id="patch1">
    <mxGraphModel dx="1200" dy="750" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="680">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="IIC — SOFS Cluster Patching Sequence (Rolling Update)" style="text;html=1;fontSize=15;fontStyle=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="100" y="10" width="900" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="subtitle" value="&lt;font color=&quot;#c62828&quot;&gt;⚠ Never patch two SOFS VMs simultaneously — this would leave a single node with no mirror partner&lt;/font&gt;" style="text;html=1;fontSize=11;fontStyle=2;align=center;" vertex="1" parent="1">
          <mxGeometry x="150" y="40" width="800" height="20" as="geometry"/>
        </mxCell>

        <!-- ═══ Round 1: iic-sofs-01 ═══ -->
        <mxCell id="r1_box" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e3f2fd;strokeColor=#1565C0;strokeWidth=2;opacity=30;" vertex="1" parent="1">
          <mxGeometry x="30" y="80" width="1040" height="145" as="geometry"/>
        </mxCell>
        <mxCell id="r1_title" value="&lt;b&gt;Round 1:&lt;/b&gt; iic-sofs-01" style="text;html=1;fontSize=12;fontColor=#1565C0;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="85" width="200" height="20" as="geometry"/>
        </mxCell>

        <!-- Cluster state before -->
        <mxCell id="r1_vm1" value="&lt;b&gt;iic-sofs-01&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#ef6c00&quot; style=&quot;font-size:9px&quot;&gt;⏸ DRAINING&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff3e0;strokeColor=#ef6c00;fontSize=10;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="50" y="115" width="120" height="45" as="geometry"/>
        </mxCell>
        <mxCell id="r1_vm2" value="&lt;b&gt;iic-sofs-02&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#2e7d32&quot; style=&quot;font-size:9px&quot;&gt;● ONLINE&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f5e9;strokeColor=#2e7d32;fontSize=10;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="50" y="170" width="120" height="45" as="geometry"/>
        </mxCell>
        <mxCell id="r1_vm3" value="&lt;b&gt;iic-sofs-03&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#2e7d32&quot; style=&quot;font-size:9px&quot;&gt;● ONLINE&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f5e9;strokeColor=#2e7d32;fontSize=10;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="185" y="170" width="120" height="45" as="geometry"/>
        </mxCell>

        <!-- Arrow 1: Drain -->
        <mxCell id="r1_arr1" value="" style="endArrow=classic;html=1;strokeWidth=2;strokeColor=#666;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="330" y="150" as="sourcePoint"/>
            <mxPoint x="380" y="150" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="r1_step1" value="&lt;b&gt;1. Drain&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8px;font-family:monospace&quot;&gt;Suspend-&lt;br&gt;ClusterNode&lt;br&gt;-Drain&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=9;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="390" y="110" width="100" height="55" as="geometry"/>
        </mxCell>

        <!-- Arrow 2 -->
        <mxCell id="r1_arr2" value="" style="endArrow=classic;html=1;strokeWidth=2;strokeColor=#666;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="500" y="150" as="sourcePoint"/>
            <mxPoint x="540" y="150" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="r1_step2" value="&lt;b&gt;2. Patch&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8px&quot;&gt;Install updates&lt;br&gt;+ reboot VM&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=9;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="550" y="110" width="100" height="55" as="geometry"/>
        </mxCell>

        <!-- Arrow 3 -->
        <mxCell id="r1_arr3" value="" style="endArrow=classic;html=1;strokeWidth=2;strokeColor=#666;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="660" y="150" as="sourcePoint"/>
            <mxPoint x="700" y="150" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="r1_step3" value="&lt;b&gt;3. Resync&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8px&quot;&gt;S2D resync&lt;br&gt;(minutes on&lt;br&gt;NVMe)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=9;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="710" y="110" width="100" height="55" as="geometry"/>
        </mxCell>

        <!-- Arrow 4 -->
        <mxCell id="r1_arr4" value="" style="endArrow=classic;html=1;strokeWidth=2;strokeColor=#666;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="820" y="150" as="sourcePoint"/>
            <mxPoint x="860" y="150" as="targetPoint"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="r1_step4" value="&lt;b&gt;4. Resume&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:8px;font-family:monospace&quot;&gt;Resume-&lt;br&gt;ClusterNode&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f5e9;strokeColor=#2e7d32;fontSize=9;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="870" y="110" width="100" height="55" as="geometry"/>
        </mxCell>

        <mxCell id="r1_avd_note" value="&lt;font style=&quot;font-size:9px;color:#1565C0&quot;&gt;AVD sessions: &lt;b&gt;Zero interruption&lt;/b&gt; — 2 nodes handle all SMB traffic via SMB Continuous Availability&lt;/font&gt;" style="text;html=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="380" y="175" width="600" height="15" as="geometry"/>
        </mxCell>

        <!-- ═══ Round 2: iic-sofs-02 ═══ -->
        <mxCell id="r2_box" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fce4ec;strokeColor=#c62828;strokeWidth=2;opacity=30;" vertex="1" parent="1">
          <mxGeometry x="30" y="240" width="1040" height="145" as="geometry"/>
        </mxCell>
        <mxCell id="r2_title" value="&lt;b&gt;Round 2:&lt;/b&gt; iic-sofs-02" style="text;html=1;fontSize=12;fontColor=#c62828;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="245" width="200" height="20" as="geometry"/>
        </mxCell>

        <mxCell id="r2_vm1" value="&lt;b&gt;iic-sofs-01&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#2e7d32&quot; style=&quot;font-size:9px&quot;&gt;● ONLINE (patched)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f5e9;strokeColor=#2e7d32;fontSize=10;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="50" y="275" width="130" height="45" as="geometry"/>
        </mxCell>
        <mxCell id="r2_vm2" value="&lt;b&gt;iic-sofs-02&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#ef6c00&quot; style=&quot;font-size:9px&quot;&gt;⏸ DRAINING&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff3e0;strokeColor=#ef6c00;fontSize=10;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="50" y="330" width="130" height="45" as="geometry"/>
        </mxCell>
        <mxCell id="r2_vm3" value="&lt;b&gt;iic-sofs-03&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#2e7d32&quot; style=&quot;font-size:9px&quot;&gt;● ONLINE&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f5e9;strokeColor=#2e7d32;fontSize=10;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="195" y="275" width="130" height="45" as="geometry"/>
        </mxCell>

        <mxCell id="r2_steps" value="&lt;font style=&quot;font-size:10px&quot;&gt;&lt;b&gt;Drain → Patch → Resync → Resume&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#666&quot;&gt;Same 4-step procedure&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="430" y="295" width="430" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="r2_avd_note" value="&lt;font style=&quot;font-size:9px;color:#c62828&quot;&gt;AVD sessions: &lt;b&gt;Zero interruption&lt;/b&gt; — iic-sofs-01 (now patched) + iic-sofs-03 handle traffic&lt;/font&gt;" style="text;html=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="380" y="345" width="600" height="15" as="geometry"/>
        </mxCell>

        <!-- ═══ Round 3: iic-sofs-03 ═══ -->
        <mxCell id="r3_box" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3e5f5;strokeColor=#7B1FA2;strokeWidth=2;opacity=30;" vertex="1" parent="1">
          <mxGeometry x="30" y="400" width="1040" height="145" as="geometry"/>
        </mxCell>
        <mxCell id="r3_title" value="&lt;b&gt;Round 3:&lt;/b&gt; iic-sofs-03" style="text;html=1;fontSize=12;fontColor=#7B1FA2;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="405" width="200" height="20" as="geometry"/>
        </mxCell>

        <mxCell id="r3_vm1" value="&lt;b&gt;iic-sofs-01&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#2e7d32&quot; style=&quot;font-size:9px&quot;&gt;● ONLINE (patched)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f5e9;strokeColor=#2e7d32;fontSize=10;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="50" y="435" width="130" height="45" as="geometry"/>
        </mxCell>
        <mxCell id="r3_vm2" value="&lt;b&gt;iic-sofs-02&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#2e7d32&quot; style=&quot;font-size:9px&quot;&gt;● ONLINE (patched)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f5e9;strokeColor=#2e7d32;fontSize=10;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="195" y="435" width="130" height="45" as="geometry"/>
        </mxCell>
        <mxCell id="r3_vm3" value="&lt;b&gt;iic-sofs-03&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#ef6c00&quot; style=&quot;font-size:9px&quot;&gt;⏸ DRAINING&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff3e0;strokeColor=#ef6c00;fontSize=10;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="50" y="490" width="130" height="45" as="geometry"/>
        </mxCell>

        <mxCell id="r3_steps" value="&lt;font style=&quot;font-size:10px&quot;&gt;&lt;b&gt;Drain → Patch → Resync → Resume&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#666&quot;&gt;Same 4-step procedure — final round&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="430" y="455" width="430" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="r3_avd_note" value="&lt;font style=&quot;font-size:9px;color:#7B1FA2&quot;&gt;AVD sessions: &lt;b&gt;Zero interruption&lt;/b&gt; — iic-sofs-01 + iic-sofs-02 (both patched) handle traffic&lt;/font&gt;" style="text;html=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="380" y="505" width="600" height="15" as="geometry"/>
        </mxCell>

        <!-- ═══ Completion ═══ -->
        <mxCell id="done_box" value="&lt;b&gt;✓ All 3 SOFS VMs patched — zero AVD session interruptions&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;color:#666&quot;&gt;Total time: ~30–45 minutes (patch + reboot × 3, plus S2D resync between each)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f5e9;strokeColor=#2e7d32;strokeWidth=2;fontSize=11;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="250" y="565" width="600" height="45" as="geometry"/>
        </mxCell>

        <!-- Arrow from R3 to Done -->
        <mxCell id="done_arr" value="" style="endArrow=classic;html=1;strokeWidth=2;strokeColor=#2e7d32;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="550" y="545" as="sourcePoint"/>
            <mxPoint x="550" y="565" as="targetPoint"/>
          </mxGeometry>
        </mxCell>

        <!-- Legend -->
        <mxCell id="legend" value="&lt;font style=&quot;font-size:8px&quot;&gt;&lt;font color=&quot;#2e7d32&quot;&gt;● ONLINE&lt;/font&gt;&amp;nbsp;&amp;nbsp;&lt;font color=&quot;#ef6c00&quot;&gt;⏸ DRAINING&lt;/font&gt;&amp;nbsp;&amp;nbsp;&lt;font color=&quot;#c62828&quot;&gt;● PATCHING&lt;/font&gt;&amp;nbsp;&amp;nbsp;— SMB CA handles all failover transparently&lt;/font&gt;" style="text;html=1;align=center;fontColor=#666;" vertex="1" parent="1">
          <mxGeometry x="250" y="620" width="600" height="15" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
