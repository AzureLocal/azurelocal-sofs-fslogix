<mxfile host="draw.io" type="device">
  <diagram name="SOFS Deployment Phases" id="dp1">
    <mxGraphModel dx="1422" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1350">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- Title -->
        <mxCell id="title" value="SOFS Deployment Phases — 11-Phase Model" style="text;html=1;fontSize=16;fontStyle=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="175" y="10" width="500" height="25" as="geometry"/>
        </mxCell>

        <!-- Swim Lane Backgrounds -->
        <mxCell id="lane_azure" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;opacity=20;strokeWidth=2;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="30" y="50" width="340" height="440" as="geometry"/>
