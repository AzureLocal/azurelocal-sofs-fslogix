        <!-- Storage Layer Flow -->
        <mxCell id="storage" value="&lt;b&gt;Storage Flow&lt;/b&gt;: Host S2D → Host CSV Volumes → Storage Paths → Data Disks → Guest S2D Pool → Guest CSV Volume(s) → SMB Shares" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;dashed=1;shadow=1;" vertex="1" parent="1">
