# -------------------------------------------------------
# parameters.example.env
# Copy this file to parameters.env and fill in your values.
# DO NOT commit parameters.env – it is excluded by .gitignore.
# Source this file before running the scripts:
#   source parameters.env
# -------------------------------------------------------

# Azure subscription and resource group
SUBSCRIPTION_ID="00000000-0000-0000-0000-000000000000"
RESOURCE_GROUP="rg-azurelocal-prod"
LOCATION="eastus"

# Azure Local cluster details (as registered in Azure Arc)
CLUSTER_NAME="azlhci-cluster"
CLUSTER_RESOURCE_GROUP="rg-azurelocal-prod"

# Diagnostic storage account (optional – for Azure Monitor / diagnostics)
DIAG_STORAGE_ACCOUNT="stazlhcidiag001"

# Tags applied to all created Azure resources
TAG_ENVIRONMENT="production"
TAG_OWNER="platform-team"
